{
  "info": {
    "name": "RenderProj - API Desarrollo Web",
    "description": "Pruebas de la API desplegada en Render. Autor: Diego Garcia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://renderproj-qhc4.onrender.com"
    }
  ],
  "item": [
    {
      "name": "Bienvenida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Entorno production\", () => pm.expect(pm.response.json().entorno).to.eql(\"production\"));",
              "pm.test(\"Autor Diego Garcia\", () => pm.expect(pm.response.json().autor).to.eql(\"Diego Garcia\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Status ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Obtener productos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Devuelve 2 productos\", () => pm.expect(pm.response.json()).to.have.lengthOf(2));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Crear producto valido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Producto validado\", () => pm.expect(pm.response.json().producto.nombre).to.eql(\"Monitor\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Monitor\",\n    \"precio\": 900\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Crear producto invalido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Mensaje de error\", () => pm.expect(pm.response.json().error).to.eql(\"Datos de producto inválidos\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"\",\n    \"precio\": -5\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "JSON mal formado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"Respuesta del middleware de errores\", () => pm.expect(pm.response.json().error).to.eql(\"Error procesando la solicitud\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": Monitor\n}"
        },
        "url": "{{baseUrl}}/api/productos"
      }
    },
    {
      "name": "Ruta no encontrada",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404\", () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/ruta-inexistente"
      }
    }
  ]
}
